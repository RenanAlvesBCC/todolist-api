@baseUrl = http://localhost:8080
# Prod (Render): https://todolist-api-tq9d.onrender.com
@owner = gerente@teste.com
@mechanic = mecanico@teste.com
@password = abcd@1234

### Health
GET {{baseUrl}}/

### Registrar owner
# @name registerOwner
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "{{owner}}",
  "password": "{{password}}",
  "first_name": "Gerente",
  "last_name": "Teste"
}

### Login owner
# @name loginOwner
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{owner}}",
  "password": "{{password}}"
}

### Registrar mecanico
# @name registerMechanic
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "{{mechanic}}",
  "password": "{{password}}",
  "first_name": "Mecanico",
  "last_name": "Teste"
}

### Login mecanico
# @name loginMechanic
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{mechanic}}",
  "password": "{{password}}"
}

### Login invalido
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "{{owner}}",
  "password": "senha-errada"
}

### Listas sem token
GET {{baseUrl}}/api/lists

### Criar workspace
# @name createWorkspace
POST {{baseUrl}}/api/workspace
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "name": "RMAXX Auto",
  "description": "Gestao de veiculos"
}

### Workspace duplicado
POST {{baseUrl}}/api/workspace
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "name": "Outra oficina"
}

### Buscar workspace
GET {{baseUrl}}/api/workspace
Authorization: Bearer {{loginOwner.response.body.token}}

### Atualizar workspace
PUT {{baseUrl}}/api/workspace
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "name": "RMAXX Auto",
  "description": "Atualizado"
}

### Gerar convite
# @name createInvite
POST {{baseUrl}}/api/workspace/invites
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "role": "editor"
}

### Listar convites
GET {{baseUrl}}/api/workspace/invites
Authorization: Bearer {{loginOwner.response.body.token}}

### Preview do convite
GET {{baseUrl}}/invites/{{createInvite.response.body.code}}/preview

### Aceitar convite
POST {{baseUrl}}/api/invites/{{createInvite.response.body.code}}/accept
Authorization: Bearer {{loginMechanic.response.body.token}}

### Listar membros
GET {{baseUrl}}/api/workspace/members
Authorization: Bearer {{loginOwner.response.body.token}}

### Criar veiculo
# @name createList
POST {{baseUrl}}/api/lists
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "title": "Fusca 1972",
  "plate": "ABC-1234",
  "customer": "João Silva",
  "customer_cpf": "123.456.789-09",
  "customer_cep": "01310-100",
  "customer_whatsapp": "+55 (11) 98765-4321",
  "mileage": 87500
}

### Criar veiculo com CPF invalido (400)
POST {{baseUrl}}/api/lists
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "title": "Veiculo invalido",
  "customer_cpf": "111.111.111-11"
}

### Criar segundo veiculo
# @name createList2
POST {{baseUrl}}/api/lists
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "title": "Gol 2010",
  "plate": "XYZ-9876",
  "customer": "Maria Souza"
}

### Listar veiculos
GET {{baseUrl}}/api/lists?page=1&limit=20
Authorization: Bearer {{loginOwner.response.body.token}}

### Buscar veiculos
GET {{baseUrl}}/api/lists?search=Fusca
Authorization: Bearer {{loginOwner.response.body.token}}

### Buscar veiculo por id
GET {{baseUrl}}/api/lists/{{createList.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}

### Atualizar ficha do veiculo
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "title": "Fusca 1972 revisao",
  "plate": "ABC-1234",
  "customer": "João Silva"
}

### Atualizar dados do cliente (chave ausente mantem; "" limpa)
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "title": "Fusca 1972 revisao",
  "plate": "ABC-1234",
  "customer": "João Silva",
  "customer_cep": "",
  "customer_whatsapp": "(11) 3456-7890"
}

### Atualizar quilometragem (ausente ou null mantem; numero grava)
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "title": "Fusca 1972 revisao",
  "plate": "ABC-1234",
  "customer": "João Silva",
  "mileage": 91200
}

### Quilometragem invalida (400 quilometragem inválida: negativa, > 2000000, decimal ou string)
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "title": "Fusca 1972 revisao",
  "mileage": "91200"
}

### Alterar prioridade (normal | alta | urgente)
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/priority
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "priority": "urgente"
}

### Prioridade invalida (400)
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/priority
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "priority": "baixa"
}

### Reordenar veiculos
PUT {{baseUrl}}/api/lists/reorder
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "ids": [{{createList2.response.body.id}}, {{createList.response.body.id}}]
}

### Adicionar item
# @name addItem
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/items
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "text": "Troca de oleo"
}

### Adicionar segundo item
# @name addItem2
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/items
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "text": "Pastilha de freio"
}

### Atualizar item
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/items/{{addItem.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "text": "Troca de oleo",
  "completed": true
}

### Reordenar itens
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/items/reorder
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "ids": [{{addItem2.response.body.id}}, {{addItem.response.body.id}}]
}

### Alterar status
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/status
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "status": "aguardando_orcamento"
}

### Adicionar orcamento
# @name addQuote
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/quotes
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "text": "Pastilha de freio R$120"
}

### Listar orcamentos
GET {{baseUrl}}/api/lists/{{createList.response.body.id}}/quotes
Authorization: Bearer {{loginOwner.response.body.token}}

### Adicionar pendencia
# @name addFlag
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/flags
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "flag_type": "aguardando_peca",
  "note": ""
}

### Pendencia outro com nota curta
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/flags
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "flag_type": "outro",
  "note": "curto"
}

### Listar pendencias
GET {{baseUrl}}/api/lists/{{createList.response.body.id}}/flags
Authorization: Bearer {{loginOwner.response.body.token}}

### Resolver pendencia
PATCH {{baseUrl}}/api/lists/{{createList.response.body.id}}/flags/{{addFlag.response.body.id}}/resolve
Authorization: Bearer {{loginOwner.response.body.token}}

### Adicionar informacao importante
# @name addNote
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/notes
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "text": "Cliente pediu para ligar antes de trocar a correia.\nPrefere WhatsApp."
}

### Informacao importante vazia (400)
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/notes
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "text": "   "
}

### Listar informacoes importantes (mais recente primeiro)
GET {{baseUrl}}/api/lists/{{createList.response.body.id}}/notes
Authorization: Bearer {{loginOwner.response.body.token}}

### Excluir informacao importante (exclusao logica)
DELETE {{baseUrl}}/api/lists/{{createList.response.body.id}}/notes/{{addNote.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}

### Atribuir mecanico
POST {{baseUrl}}/api/lists/{{createList.response.body.id}}/assignments
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "user_id": 2
}

### Listar atribuicoes
GET {{baseUrl}}/api/lists/{{createList.response.body.id}}/assignments
Authorization: Bearer {{loginOwner.response.body.token}}

### Mecanico marca o video de check-up (precisa estar atribuido)
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/checkup-video
Authorization: Bearer {{loginMechanic.response.body.token}}
Content-Type: application/json

{
  "done": true
}

### Desmarcar video de check-up
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/checkup-video
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "done": false
}

### Remover orcamento
DELETE {{baseUrl}}/api/lists/{{createList.response.body.id}}/quotes/{{addQuote.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}

### Remover item
DELETE {{baseUrl}}/api/lists/{{createList.response.body.id}}/items/{{addItem2.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}

### Marcar como entregue (grava delivered_at)
PUT {{baseUrl}}/api/lists/{{createList.response.body.id}}/status
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "status": "entregue"
}

### Ver veiculo entregue (delivered_at preenchido)
GET {{baseUrl}}/api/lists/{{createList.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}

### Excluir veiculo
DELETE {{baseUrl}}/api/lists/{{createList.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}

### Logout
POST {{baseUrl}}/api/logout
Authorization: Bearer {{loginOwner.response.body.token}}

### Meu workspace (inclui role)
GET {{baseUrl}}/api/workspace
Authorization: Bearer {{loginOwner.response.body.token}}

### Esteira do mecanico (sem customer_cpf/customer_cep/customer_whatsapp no JSON)
GET {{baseUrl}}/api/lists?mine=true
Authorization: Bearer {{loginMechanic.response.body.token}}

### Patio filtrado por status
GET {{baseUrl}}/api/lists?status=em_andamento
Authorization: Bearer {{loginOwner.response.body.token}}

### Auditoria
GET {{baseUrl}}/api/audit?page=1&limit=20
Authorization: Bearer {{loginOwner.response.body.token}}

### ---- Clientes (so dono/gerente; refaca o login se tiver feito logout acima) ----

### Criar cliente local
# @name createCustomer
POST {{baseUrl}}/api/customers
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "name": "Maria Souza",
  "person_type": "pf",
  "cpf": "123.456.789-09",
  "mobile": "+55 (11) 98765-4321",
  "email": "maria@exemplo.com",
  "cep": "01310-100",
  "city": "Sao Paulo",
  "uf": "SP",
  "birth_date": "03/05/1980"
}

### CPF duplicado (409 com existing_id)
POST {{baseUrl}}/api/customers
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "name": "Outra Maria",
  "cpf": "12345678909"
}

### Buscar clientes (nome, CPF, telefone, e-mail ou placa)
GET {{baseUrl}}/api/customers?search=maria&page=1&limit=20
Authorization: Bearer {{loginOwner.response.body.token}}

### Detalhe do cliente (com veiculos completos)
GET {{baseUrl}}/api/customers/{{createCustomer.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}

### Editar cliente (chave ausente mantem)
PUT {{baseUrl}}/api/customers/{{createCustomer.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "city": "Campinas",
  "notes": "Prefere WhatsApp"
}

### Mecanico nao acessa clientes (403)
GET {{baseUrl}}/api/customers
Authorization: Bearer {{loginMechanic.response.body.token}}

### ---- Veiculos do cliente e historico (so dono/gerente) ----

### Cadastrar veiculo do cliente
# @name createCustomerVehicle
POST {{baseUrl}}/api/customers/{{createCustomer.response.body.id}}/vehicles
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "plate": "abc-1d23",
  "manufacturer": "VW",
  "model": "Gol 1.6",
  "year_fab": 2014,
  "year_model": 2015,
  "color": "Prata",
  "last_mileage": 87500
}

### Placa repetida (409 com existing_id)
POST {{baseUrl}}/api/customers/{{createCustomer.response.body.id}}/vehicles
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "plate": "ABC1D23"
}

### Veiculos do cliente
GET {{baseUrl}}/api/customers/{{createCustomer.response.body.id}}/vehicles
Authorization: Bearer {{loginOwner.response.body.token}}

### Editar veiculo do cliente
PUT {{baseUrl}}/api/customer-vehicles/{{createCustomerVehicle.response.body.id}}
Authorization: Bearer {{loginOwner.response.body.token}}
Content-Type: application/json

{
  "color": "Preto"
}

### Reconhecer carro pela placa
GET {{baseUrl}}/api/customer-vehicles/lookup?plate=ABC-1D23
Authorization: Bearer {{loginOwner.response.body.token}}

### Historico do carro (OnMotor + atendimentos)
GET {{baseUrl}}/api/customer-vehicles/{{createCustomerVehicle.response.body.id}}/history
Authorization: Bearer {{loginOwner.response.body.token}}
